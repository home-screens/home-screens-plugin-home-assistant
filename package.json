{
  "name": "hs-plugin-home-assistant",
  "version": "1.4.0",
  "description": "Home Assistant integration for Home Screens — rich entity cards, area grouping, and interactive controls for lights, climate, media, covers, and locks",
  "license": "MIT",
  "scripts": {
    "dev": "vite build && (vite build --watch & npx -y serve@latest . -l 5173 --cors --no-clipboard)",
    "build": "vite build",
    "test": "vitest run",
    "e2e:setup": "esbuild e2e/react-globals.js --bundle --format=iife --outfile=e2e/.tmp/react-globals.js --define:process.env.NODE_ENV=\\\"development\\\"",
    "e2e:scale": "node e2e/measure.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  }
}
